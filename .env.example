BOT_TOKEN=123456:CHANGE_ME

# PostgreSQL. En un servidor ya existente, estos valores deben coincidir con
# las credenciales REALES de la base actual antes de rotarlas.
POSTGRES_DB=frexo
POSTGRES_USER=frexo
POSTGRES_PASSWORD=frexo
DATABASE_URL=postgresql+asyncpg://frexo:frexo@postgres:5432/frexo
REDIS_URL=redis://redis:6379/0
SUPPORT_USERNAME=@TuSoporte
ADMIN_IDS=
FREE_DAILY_SEARCH_LIMIT=30
DEFAULT_NEARBY_RADIUS_KM=100

# Seguridad / antiabuso
CHAT_MESSAGES_LIMIT=8
CHAT_MESSAGES_WINDOW_SECONDS=5
NEXT_LIMIT=8
NEXT_WINDOW_SECONDS=120
SEARCH_BURST_LIMIT=10
SEARCH_BURST_WINDOW_SECONDS=60
REPORT_DAILY_LIMIT=5
PROTECT_RELAYED_CONTENT=true

# Calidad de conversación
GHOSTING_NUDGE_MINUTES=15
CONVERSATION_IDLE_CLOSE_HOURS=24
CONSECUTIVE_MESSAGE_NUDGE=4

# Producción
ENVIRONMENT=production
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8080
BACKUP_INTERVAL_SECONDS=86400
LEGAL_EFFECTIVE_DATE=21/08/2026
